# Models — never commit GGUF blobs
*.gguf
models/*.gguf

# TTS — venv + Kokoro/Piper model blobs
tts/.venv/
tts/.venv-piper/
tts/voices/
tts/*.onnx
tts/*.bin

# Python — bytecode caches
__pycache__/
*.pyc

# Node
orchestrator/node_modules/
orchestrator/dist/
*.log

# Swift / Xcode
app/Jarvis.xcodeproj/
app/.build/
app/build/
app/DerivedData/
*.xcuserstate

# iOS on-device model tier — llama.cpp clone + built XCFramework (rebuild with
# scripts/build-llama-xcframework.sh)
app/Vendor/

# Memory — volatile short-term buffer + captured screenshots (long-term + personality are kept)
memory/short-term/*.md
memory/screenshots/
# Runtime conversation sessions + PM project state (per-run artifacts, not source)
memory/sessions/
memory/projects/

# macOS
.DS_Store

# Secrets
.env
*.local

# Editor Extension
node_modules
editor-extension/out/
*.vsix


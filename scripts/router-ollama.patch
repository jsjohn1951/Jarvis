+# ── Alternate cloud provider (Ollama Cloud) ───────────────────────────────────
+#
+# The Jarvis orchestrator inserts an Ollama-Cloud tier into its fallback chain
+# (Claude → Ollama → local) by sending requests whose `model` is the configured
+# Ollama model. The key + model live in providers.json (written 0600 by the
+# orchestrator); we read it lazily (mtime-cached) so a settings change is picked
+# up without restarting the router. Ollama Cloud speaks the OpenAI format, so we
+# reuse the same to_openai/from_openai translation as the local path.
+OLLAMA_BASE_DEFAULT = "https://ollama.com/v1"
+_PROVIDERS_PATH = os.path.expanduser(
+    os.environ.get("JARVIS_PROVIDERS_FILE", "~/.claude/router/providers.json")
+)
+_providers_cache = {"mtime": -1.0, "data": {}}
+
+
+def _load_providers() -> dict:
+    try:
+        mtime = os.stat(_PROVIDERS_PATH).st_mtime
+    except OSError:
+        return {}
+    if mtime != _providers_cache["mtime"]:
+        try:
+            with open(_PROVIDERS_PATH) as f:
+                _providers_cache["data"] = json.load(f)
+            _providers_cache["mtime"] = mtime
+        except (json.JSONDecodeError, OSError):
+            pass
+    return _providers_cache["data"]
+
+
+def _ollama_cfg():
+    """Return the Ollama provider config iff it's enabled and usable, else None."""
+    o = _load_providers().get("ollama") or {}
+    if o.get("enabled") and o.get("apiKey") and o.get("model"):
+        return o
+    return None
+
+
+def routes_to_ollama(body: dict) -> bool:
+    o = _ollama_cfg()
+    if not o:
+        return False
+    model = body.get("model") or ""
+    return model == o["model"] or model.lower().startswith("ollama")
+
+
